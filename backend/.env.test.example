# Used automatically when NODE_ENV=test (see package.json "test" script).
# Point this at a separate database so tests never touch dev/demo data.
PORT=4001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/car_dealership_test
JWT_SECRET=test_secret_key_do_not_use_in_production
JWT_EXPIRES_IN=1h
